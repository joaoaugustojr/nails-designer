# Copy to .env for local development. Never commit .env.

# Seals the session cookie. Required in production (dev generates one).
# Generate with: openssl rand -base64 32
NUXT_APP_SECRET=

# SQLite file (libsql URL). Default: file:.data/nails.db
# NUXT_DB_URL=file:.data/nails.db

# Folder for uploaded images (logo, cover, service photos). Default: .data/uploads
# NUXT_UPLOADS_DIR=.data/uploads

# Public address of the site, used for links in WhatsApp messages. Default: http://localhost:3000
# NUXT_SITE_URL=https://example.com

# Store name used to create the settings row on first boot; edited in the panel afterwards.
NUXT_STORE_NAME=

# First panel user, created at boot only while there are no users.
NUXT_ADMIN_NAME=
NUXT_ADMIN_EMAIL=
NUXT_ADMIN_PASSWORD=
