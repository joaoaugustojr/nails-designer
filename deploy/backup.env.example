# Copy to /srv/nails/backup.env (chmod 600). Read by backup.sh and passed to rclone.
HEALTHCHECK_URL=https://hc-ping.com/<check uuid>
R2_BUCKET=<bucket name>

# rclone remote "r2", configured through environment variables.
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
# The R2 token is limited to the bucket, so rclone must not try to create it.
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
